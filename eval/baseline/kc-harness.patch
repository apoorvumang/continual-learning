+    # A dead judge (bad key, no credit, rate limit) labels every row "abstain",
+    # which looks exactly like a model that hedges on everything — a 100%-abstain
+    # curve with no error anywhere. Refuse to emit a run that is mostly judge
+    # failure rather than let it be read as a result.
+    judge_errors = sum(1 for r in results if str(r.get("reason", "")).startswith("judge error"))
+    if judge_errors:
+        rate = judge_errors / max(len(results), 1)
+        msg = (f"{judge_errors}/{len(results)} rows ({rate:.0%}) failed to grade. "
+               f"First: {next(r['reason'] for r in results if str(r.get('reason','')).startswith('judge error'))}")
+        if rate > 0.02:
+            raise RuntimeError(f"judge is broken -- refusing to write {out_path}. {msg}")
+        print(f"warning: {msg}")
+
     with open(out_path, "w", encoding="utf-8") as out:
         for r in results:
             out.write(json.dumps(r, ensure_ascii=False) + "\n")
