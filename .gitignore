.venv/
__pycache__/
*.pyc
.env.local
.env

# wandb local run dirs (runs live on wandb.ai)
wandb/
scripts/wandb/

# generated synthetic corpus: 22MB and fully reproducible from the committed
# *.plan.json (universe context + key facts + document ideas) with a fixed seed
data/sdf/*.docs.jsonl

# adapters, merged checkpoints
runs/
ckpts/

# 2026 news corpus: ~3.5k fetched articles, reproducible from
# scripts/retrieve_news_2026.py (Wikipedia seed is stable, keenable fetch is not archival)
data/news2026/

# 100M-token synthetic corpus, regenerable from scripts/amplify_news.py
data/news2026/synth.jsonl

# Megatron/ms-swift training envs: .venv-mega2 alone is ~20GB of wheels plus a source-built
# TransformerEngine. Reproduce with docs/DEEPSEEK-V4.md, not from git.
.venv-mega/
.venv-mega2/
.venv-vllm/

# mcore dist-checkpoints (568GB), LoRA adapters (13GB each) and merged bf16 exports
megatron_output/

# thinking-format variants, regenerable from scripts/build_thinkfix_variants.py
data/thinkfix/

# format-sweep arms: ~235MB, regenerable from scripts/build_formats_dsv4.py + qa-v2.jsonl
data/formats/
data/news2026/qa-v2.jsonl
